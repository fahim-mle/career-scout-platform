# Database
DB_NAME=career-scout
DB_USER=postgres
# See secrets/db_password.txt
DB_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0

# Application
LOG_LEVEL=INFO
DEBUG=false

# LLM (for later milestones)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=

# Scraper credentials (required for LinkedIn scraping tasks)
SCRAPER_ENABLED=false
LINKEDIN_EMAIL=you@example.com
# Prefer file-based secret for local/dev containers
LINKEDIN_PASSWORD_FILE=secrets/linkedin_password.txt
# Optional fallback when LINKEDIN_PASSWORD_FILE is unset
LINKEDIN_PASSWORD=

# Monitoring
GRAFANA_USER=admin
# See secrets/grafana_password.txt
GRAFANA_PASSWORD=

# pgAdmin
PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-strong-password
